@baseUrl = http://localhost:3001

# Список образцов: фильтры и сортировка. Без токена.
# Пустой результат — [] и 200. Неизвестный type/status/sort — 400.

############################################################
# Фильтры (какие строки)
############################################################

### All samples (без фильтра, по умолчанию новые сверху)
GET {{baseUrl}}/samples

### Filter country=USA
GET {{baseUrl}}/samples?country=USA

### Filter type=WATER
GET {{baseUrl}}/samples?type=WATER

### Filter status=STORED
GET {{baseUrl}}/samples?status=STORED

### Combination country + type (AND)
GET {{baseUrl}}/samples?country=USA&type=BIOLOGICAL

### Combination country + type + status
GET {{baseUrl}}/samples?country=USA&type=DNA&status=ANALYZED

### Unknown country — пустой список, не 404
GET {{baseUrl}}/samples?country=Atlantis

### Invalid type (ожидание 400)
GET {{baseUrl}}/samples?type=MAGIC

### Invalid status (ожидание 400)
GET {{baseUrl}}/samples?status=LOST

############################################################
# Сортировка по дате
############################################################

### Newest first — sort=created_at
GET {{baseUrl}}/samples?sort=created_at

### Newest first — alias created_at_desc
GET {{baseUrl}}/samples?sort=created_at_desc

### Oldest first
GET {{baseUrl}}/samples?sort=created_at_asc

### Filter + date sort: USA, старые сверху
GET {{baseUrl}}/samples?country=USA&sort=created_at_asc

############################################################
# Сортировка по среднему рейтингу
############################################################

### Highest average first (rating = rating_desc)
GET {{baseUrl}}/samples?sort=rating

### Highest average first — явный alias
GET {{baseUrl}}/samples?sort=rating_desc

### Lowest average first (образцы без оценок в конце)
GET {{baseUrl}}/samples?sort=rating_asc

### Filter + rating: только USA, лучшие сверху
GET {{baseUrl}}/samples?country=USA&sort=rating

### Неизвестное значение sort (ожидание 400)
GET {{baseUrl}}/samples?sort=name
