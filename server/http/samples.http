@baseUrl = http://localhost:3001
@seedEmail = user1@example.com
@seedPassword = password123

# Фаза 4: CRUD карточки. Фаза 5 (первая половина): PATCH /samples/:id/status.
# Сначала Login user1 / user2, потом Create / PUT / PATCH.
# GET /samples/:id/history ещё нет — вторая половина фазы 5.

### Login seed user1
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{seedEmail}}",
  "password": "{{seedPassword}}"
}

### Login seed user2 (для 403)
# @name loginUser2
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user2@example.com",
  "password": "{{seedPassword}}"
}

############################################################
# Создание и чтение
############################################################

### Create sample (ожидание 201, status RECEIVED, sample_code SAM-YYYY-NNNNNN)
# @name createSample
POST {{baseUrl}}/samples
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "REST Client blood",
  "type": "BIOLOGICAL",
  "description": "Created from samples.http",
  "country": "USA",
  "location": "Receiving Area",
  "research_id": 15,
  "experiment_id": 31
}

### Create without token (ожидание 401)
POST {{baseUrl}}/samples
Content-Type: application/json

{
  "name": "Should fail",
  "type": "BIOLOGICAL",
  "country": "USA"
}

### Create missing fields (ожидание 400)
POST {{baseUrl}}/samples
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "No type"
}

### Create invalid type (ожидание 400)
POST {{baseUrl}}/samples
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Bad type",
  "type": "MAGIC",
  "country": "USA"
}

### List samples — открытый, без фильтра (ожидание 200, массив)
GET {{baseUrl}}/samples

### Get created sample by id from Create sample
GET {{baseUrl}}/samples/{{createSample.response.body.id}}

### Get seed sample #1 (ожидание 200, есть average_rating у SAM-2026-000124)
GET {{baseUrl}}/samples/2

### Get missing id (ожидание 404)
GET {{baseUrl}}/samples/999999

############################################################
# PUT — владелец; код/статус/created_by не меняются
############################################################

### Update name and description (ожидание 200, событие SAMPLE_UPDATED)
PUT {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "REST Client blood updated",
  "description": "Fields changed, location same",
  "status": "DESTROYED",
  "sample_code": "HACK-000001",
  "created_by": 999
}

### Update location (ожидание 200, событие LOCATION_CHANGED)
PUT {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "location": "Freezer FZ-2"
}

### Update invalid type (ожидание 400)
PUT {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "type": "MAGIC"
}

### Update without token (ожидание 401)
PUT {{baseUrl}}/samples/{{createSample.response.body.id}}
Content-Type: application/json

{
  "name": "No token"
}

### Update as user2 — чужая запись (ожидание 403)
PUT {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{loginUser2.response.body.token}}
Content-Type: application/json

{
  "name": "Stolen name"
}

### Update missing id (ожидание 404)
PUT {{baseUrl}}/samples/999999
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Ghost"
}

############################################################
# DELETE — владелец 204; чужой 403; каскад documents/ratings/events
############################################################

### Delete as user2 — чужая запись (ожидание 403)
DELETE {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{loginUser2.response.body.token}}

### Delete without token (ожидание 401)
DELETE {{baseUrl}}/samples/{{createSample.response.body.id}}

### Delete missing id (ожидание 404)
DELETE {{baseUrl}}/samples/999999
Authorization: Bearer {{login.response.body.token}}

### Delete own sample (ожидание 204, тело пустое)
DELETE {{baseUrl}}/samples/{{createSample.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### Get after delete (ожидание 404)
GET {{baseUrl}}/samples/{{createSample.response.body.id}}

############################################################
# PATCH status — первая половина фазы 5 (карта переходов)
# Не используйте createSample выше: его DELETE уже снял запись.
############################################################

### Create sample for status machine
# @name createStatusSample
POST {{baseUrl}}/samples
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "name": "Status machine vial",
  "type": "CHEMICAL",
  "country": "USA",
  "location": "Receiving Area"
}

### PATCH RECEIVED → REGISTERED (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "REGISTERED"
}

### PATCH skip REGISTERED → IN_ANALYSIS (ожидание 400 Invalid status transition)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "IN_ANALYSIS"
}

### PATCH REGISTERED → STORED (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "STORED"
}

### PATCH STORED → IN_ANALYSIS (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "IN_ANALYSIS"
}

### PATCH IN_ANALYSIS → ANALYZED (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "ANALYZED"
}

### PATCH ANALYZED → ARCHIVED (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "ARCHIVED"
}

### PATCH ARCHIVED → DESTROYED (ожидание 200)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "DESTROYED"
}

### PATCH DESTROYED → STORED (ожидание 400 Invalid status transition)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "STORED"
}

### PATCH without token (ожидание 401)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Content-Type: application/json

{
  "status": "STORED"
}

### PATCH as user2 — чужая запись (ожидание 403)
PATCH {{baseUrl}}/samples/{{createStatusSample.response.body.id}}/status
Authorization: Bearer {{loginUser2.response.body.token}}
Content-Type: application/json

{
  "status": "STORED"
}

### PATCH missing id (ожидание 404)
PATCH {{baseUrl}}/samples/999999/status
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "status": "REGISTERED"
}
