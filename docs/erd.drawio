        <mxCell id="ex-t" value="api-contract.md — примеры запросов" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ex-s" value="Защищённые маршруты: Authorization: Bearer &lt;jwt&gt;. Пароль в ответах не возвращается." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#57534E;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1500" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ex-reg" value="POST /auth/register  {   &quot;username&quot;: &quot;user1&quot;,   &quot;email&quot;: &quot;user1@example.com&quot;,   &quot;password&quot;: &quot;password123&quot; }  201  { id, username, email, created_at } 400  email занят / данные неверны" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ex-log" value="POST /auth/login  {   &quot;email&quot;: &quot;user1@example.com&quot;,   &quot;password&quot;: &quot;password123&quot; }  200  { token, user } 401  неверный логин или пароль" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="500" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ex-sam" value="POST /samples  {   &quot;name&quot;: &quot;Blood sample&quot;,   &quot;type&quot;: &quot;BIOLOGICAL&quot;,   &quot;country&quot;: &quot;USA&quot;,   &quot;location&quot;: &quot;Receiving Area&quot; }  201  sample_code, status=RECEIVED" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1080" y="90" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="ex-st" value="PATCH /samples/124/status { &quot;status&quot;: &quot;IN_ANALYSIS&quot; }  STORED → IN_ANALYSIS   200 DESTROYED → STORED     400" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="500" height="200" as="geometry" />
