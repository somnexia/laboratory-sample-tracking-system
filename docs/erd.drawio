  <diagram name="Карта API" id="xNThRVoWz6sH-jEyl8iy">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="api-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" value="REST API — группы маршрутов (п. 1.6)" vertex="1">
          <mxGeometry height="30" width="640" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="api-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#57534E;" value="Полные тела и коды 201 / 400 / 401 / 403 / 404 — docs/api-contract.md" vertex="1">
          <mxGeometry height="24" width="720" x="40" y="56" as="geometry" />
        </mxCell>
        <mxCell id="g-auth" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" value="Auth — открытый / JWT&#xa;&#xa;POST /auth/register    201 400&#xa;POST /auth/login       200 400 401&#xa;GET  /auth/me          200 401" vertex="1">
          <mxGeometry height="130" width="360" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="g-samples" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" value="Samples — CRUD + статус + история&#xa;&#xa;POST   /samples                 JWT  201 400 401&#xa;GET    /samples                 open 200&#xa;        ?country &amp; type &amp; status &amp; sort=rating&#xa;GET    /samples/:id             open 200 404&#xa;PUT    /samples/:id             owner 200 400 401 403 404&#xa;DELETE /samples/:id             owner 204 401 403 404&#xa;PATCH  /samples/:id/status      owner 200 400 401 403 404&#xa;GET    /samples/:id/history     open 200 404" vertex="1">
          <mxGeometry height="220" width="460" x="430" y="100" as="geometry" />
        </mxCell>
        <mxCell id="g-docs" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" value="Documents — как Photo в ТЗ&#xa;&#xa;POST   /samples/:id/documents   JWT  201 400 401 404&#xa;GET    /samples/:id/documents   open 200 404&#xa;DELETE /documents/:id           owner 204 401 403 404" vertex="1">
          <mxGeometry height="130" width="360" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="g-ratings" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" value="Ratings — оценка 1–5&#xa;&#xa;POST   /samples/:id/ratings     JWT  201 400 401 404&#xa;GET    /samples/:id/rating      open 200 404  (среднее)&#xa;GET    /samples/:id/ratings     open 200 404&#xa;PUT    /ratings/:id             owner 200 400 401 403 404&#xa;DELETE /ratings/:id             owner 204 401 403 404" vertex="1">
          <mxGeometry height="160" width="360" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="g-codes" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;" value="Коды&#xa;&#xa;201 создан&#xa;204 удалён&#xa;400 валидация / переход / дубликат&#xa;401 нет или неверный JWT&#xa;403 не владелец&#xa;404 нет записи" vertex="1">
          <mxGeometry height="180" width="280" x="430" y="350" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
