  <diagram id="api-map" name="Карта API">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="api-title" value="REST API — группы маршрутов (п. 1.6)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="api-sub" value="Полные тела и коды 201 / 400 / 401 / 403 / 404 — docs/api-contract.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#57534E;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="g-auth" value="Auth — открытый / JWT&#xa;&#xa;POST /auth/register    201 400&#xa;POST /auth/login       200 400 401&#xa;GET  /auth/me          200 401" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="g-samples" value="Samples — CRUD + статус + история&#xa;&#xa;POST   /samples                 JWT  201 400 401&#xa;GET    /samples                 open 200&#xa;        ?country &amp; type &amp; status &amp; sort=rating&#xa;GET    /samples/:id             open 200 404&#xa;PUT    /samples/:id             owner 200 400 401 403 404&#xa;DELETE /samples/:id             owner 204 401 403 404&#xa;PATCH  /samples/:id/status      owner 200 400 401 403 404&#xa;GET    /samples/:id/history     open 200 404" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="460" height="220" as="geometry" />
        </mxCell>
        <mxCell id="g-docs" value="Documents — как Photo в ТЗ&#xa;&#xa;POST   /samples/:id/documents   JWT  201 400 401 404&#xa;GET    /samples/:id/documents   open 200 404&#xa;DELETE /documents/:id           owner 204 401 403 404" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="g-ratings" value="Ratings — оценка 1–5&#xa;&#xa;POST   /samples/:id/ratings     JWT  201 400 401 404&#xa;GET    /samples/:id/rating      open 200 404  (среднее)&#xa;GET    /samples/:id/ratings     open 200 404&#xa;PUT    /ratings/:id             owner 200 400 401 403 404&#xa;DELETE /ratings/:id             owner 204 401 403 404" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#0F766E;fontSize=12;" vertex="1" parent="1">
